# Copy this file to .env.local and fill in the real values before deploying.
# .env.local is already gitignored — never commit real keys.

# --- Resend (sends the enquiry email) -----------------------------------
# Sign up at https://resend.com (free tier is enough for this volume).
# Create an API key under Settings → API Keys.
RESEND_API_KEY=

# Where enquiries land. Set this to the owner's real inbox.
CONTACT_TO_EMAIL=

# The "from" address emails are sent as. Resend requires the domain to be
# verified (Settings → Domains) before you can send from your own domain —
# until that's done, onboarding@resend.dev works for testing.
CONTACT_FROM_EMAIL="Log Homes International <onboarding@resend.dev>"

# --- Cloudflare Turnstile (bot protection) ------------------------------
# Sign up at https://dash.cloudflare.com/?to=/:account/turnstile and add a
# site to get real keys — takes about two minutes, no domain verification
# needed for Turnstile itself.
#
# The values below are Cloudflare's own published dummy keys — they always
# pass, work on any domain including localhost, and are meant for exactly
# this situation (see https://developers.cloudflare.com/turnstile/troubleshooting/testing/).
# The form is fully clickable/testable with these, but replace both before
# launch — dummy keys accept any request as human and provide no real
# protection.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
